{
  "name": "ccc",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "cf:pages:deploy": "npm run build && wrangler pages deploy dist",
    "cf:wrangler:preview": "npm run build && wrangler preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "parse": "run-s parse:indigenous parse:youth classify",
    "parse:indigenous": "node --env-file-if-exists=.dev.vars --import tsx src/cli.ts",
    "audit:indigenous": "node --import tsx src/audit.ts",
    "parse:youth": "node --env-file-if-exists=.dev.vars --import tsx src/cli-youth.ts",
    "classify": "node --env-file-if-exists=.dev.vars --import tsx src/cli-classify.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit --project tsconfig.parser.json"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.164",
    "cheerio": "^1.2.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^4.10.38",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.40.2"
  },
  "engines": {
    "node": ">=22"
  }
}
